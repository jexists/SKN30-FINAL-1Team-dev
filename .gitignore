# ─────────────────────────────────────────────
# OS (맥 / 윈도우 혼용이므로 양쪽 모두 필요)
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─────────────────────────────────────────────
# 환경변수 (템플릿만 커밋)
# 경로 없는 패턴이라 frontend/.env, backend/.env 모두 깊이와 무관하게 걸린다.
# ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# Node / Frontend
# ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
logs/
*.log

# ─────────────────────────────────────────────
# Python / Backend
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────
# IDE / 에디터
# ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?

# Office 임시 잠금 파일
~$*.docx
~$*.xlsx
~$*.pptx

# 외부 제공 자료는 공개 재배포 허가 전까지 로컬에서만 보관
docs/references/*
!docs/references/README.md
!docs/references/form_docs/
docs/references/form_docs/*
!docs/references/form_docs/README.md

# 실제 수집·가공 데이터는 저장소에 올리지 않음
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ─────────────────────────────────────────────
# AI 도구 (개인 설정만 제외, 팀 공용 설정은 커밋)
# ─────────────────────────────────────────────
.claude/settings.local.json
.claude/plans/
.playwright-mcp/

# NOTE: uv.lock 과 package-lock.json 은 버전 고정이 목적이므로 커밋한다.
