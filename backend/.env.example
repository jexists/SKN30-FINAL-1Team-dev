# 서버 프로세스 안에만 존재하는 값. 외부에 노출되지 않는다.
# 실제 값은 .env 에 채우고, .env 는 절대 커밋하지 않는다.

# 앱
APP_ENV=local
DEBUG=true
# 외부 LLM/Supabase 실통합 테스트를 실행할 때만 true로 설정
RUN_INTEGRATION_TESTS=false

# CORS (프론트 개발 서버 주소)
CORS_ORIGINS=http://localhost:5173

# DB (Supabase)
#
# Supabase 대시보드 > Project Settings > Database > Connection string 에서 복사.
# 드라이버 접두사(+asyncpg)는 코드가 자동으로 붙이므로 postgresql:// 그대로 두면 된다.
#
# 앱은 Transaction pooler(포트 6543) 기준이다.
# Supabase Connect > Transaction pooler > URI 를 복사한다.
# Session pooler(5432)는 프로젝트 전체가 클라이언트 15 개를 나눠 쓰기 때문에,
# 배포 서버와 팀원들의 로컬 서버가 같이 붙으면 화면 하나가 요청 여러 개를 동시에
# 보내는 순간 EMAXCONNSESSION 으로 500 이 난다.
#
# 스키마 변경은 backend/sql/ 의 SQL 을 Supabase SQL Editor 에서 실행한다.
# 관리 작업에는 앱 연결 문자열 대신 direct 연결을 사용한다 (backend/sql/README.md 참고).
DATABASE_URL=

# Supabase Auth (로그인)
#
# Project Settings > API Keys > Publishable key 의 값.
# password login 호출에만 쓰며 프론트로 내보내지 않는다.
#
# 일반 계정은 /admin 화면에서 발급한다. 어드민 계정 자신과 개발 DB 재구축만
# Dashboard > Authentication > Users 에서 직접 만든다 (backend/sql/README.md 참고).
# 이메일과 비밀번호는 이 파일을 포함해 저장소 어디에도 두지 않는다.
SUPABASE_PUBLISHABLE_KEY=

# 계정 발급 (/admin)
#
# 계정을 발급할 수 있는 Supabase 사용자 id 목록. 쉼표로 여러 개 지정 가능.
# 권한의 근거를 DB 밖에 둔다. member 행만 고쳐서는 어드민이 될 수 없다.
# UID 는 자격증명이 아니지만 환경에 종속된 값이라 이 파일에 두지 않는다.
ADMIN_USER_IDS=

# 초대 메일이 착지할 프론트 주소. Supabase Dashboard 의 Redirect URLs 에도
# 같은 주소의 /set-password 를 등록해야 링크가 되돌아온다.
FRONTEND_BASE_URL=http://localhost:5173

# 미사용 세션이 만료되기까지의 시간. 기본 30일.
# Supabase Dashboard 의 Inactivity timeout 과 같은 값으로 맞춘다.
# REFRESH_COOKIE_MAX_AGE_SECONDS=2592000

# 계정 요청 알림 (/signup)
#
# 요청이 도착할 팀 Discord 채널의 웹훅 주소.
# 채널 설정 > 연동 > 웹후크 > 새 웹후크 > 웹후크 URL 복사.
# 이 URL 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있으므로 커밋하지 않는다.
DISCORD_WEBHOOK_URL=

# Supabase Storage (자료실 파일) 와 계정 발급이 함께 쓰는 키
# Project Settings > API Keys > Secret keys 의 값. 서버에서만 쓰고 브라우저로 보내지 않는다.
# RLS 를 우회하고 사용자를 만들고 지울 수 있다. 유출되면 계정 전체가 넘어간다.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=salesluv-documents

# 외부 Responses 호환 API
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_KEY=
# LLM_API_KEY가 비어 있을 때 사용할 수 있는 OpenAI 표준 변수명
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=180

# 문서 청크 임베딩. 비워 두면 키워드 기반 RAG fallback을 사용한다.
EMBEDDING_PROVIDER=none
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# EMBEDDING_PROVIDER=local 일 때 사용. 첫 호출 시 로컬 모델을 내려받는다.
EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_TIMEOUT_SECONDS=30

# none: OCR 미사용, runpod: Runpod Serverless OCR worker, azure: Azure Document Intelligence,
# local: PaddleOCR/pdf-inspector
OCR_PROVIDER=none
# runpod 계약: salesluv(내부 워커) 또는 mineru(공개 MinerU 워커)
OCR_RUNPOD_CONTRACT=salesluv
OCR_API_URL=
OCR_API_KEY=
# Runpod: https://api.runpod.ai/v2/{ENDPOINT_ID} 또는 /runsync URL
OCR_RUNPOD_WAIT_SECONDS=120
# 서명 URL을 발급할 수 없을 때만 원본을 inline 전송한다.
OCR_RUNPOD_INLINE_MAX_BYTES=14680064
# Runpod 워커가 Supabase Storage 원본을 가져갈 수 있는 서명 URL 수명
OCR_RUNPOD_SIGNED_URL_EXPIRES_SECONDS=300
BUSINESS_CARD_MAX_BYTES=10485760
# 명함 사진을 OCR에 넣기 전 축소할 최대 변 길이. 너무 큰 원본의 CPU·메모리 부담을 줄인다.
BUSINESS_CARD_MAX_SIDE=2400
# OCR_PROVIDER=local 일 때 PaddleOCR 언어. 한국어 명함·문서는 korean 권장.
OCR_LOCAL_LANGUAGE=korean
OCR_TIMEOUT_SECONDS=150
# 자동 다운로드 가능한 모델 캐시 경로. 비워 두면 OS 임시 폴더를 사용한다.
PDF_INSPECTOR_MODEL_DIRECTORY=
PADDLEX_CACHE_HOME=

# 자료실 보관 정책. 임시 OCR·요약 7일, 미승인 원본 30일, 승인·수정 이력 5년.
DOCUMENT_REVIEW_DRAFT_RETENTION_DAYS=7
DOCUMENT_UNAPPROVED_FILE_RETENTION_DAYS=30
DOCUMENT_AUDIT_LOG_RETENTION_DAYS=1825

# HWP5 추출기. 비워 두면 PATH에서 hwp5txt/hwp5txt.exe를 찾는다.
HWP5TXT_PATH=
SOFFICE_PATH=

# OpenAI 미팅 음성 전사. API 키는 서버에서만 사용한다.
STT_API_KEY=
STT_MODEL=gpt-4o-transcribe
STT_TIMEOUT_SECONDS=120
# OpenAI 파일 전사 한도인 25 MiB 이하에서만 설정한다.
# STT_MAX_BYTES=26214400

# 최종 딜 성사 확률 모델 산출물 디렉터리. 로컬 기본값은 backend/pipeline/artifacts다.
# 배포에서는 검증된 산출물 디렉터리를 컨테이너에 읽기 전용으로 마운트한다.
# DEAL_MODEL_DIR=/app/pipeline/artifacts
