            "a3f37008-d5d1-59d3-8fcb-b5bbfae18cb5",
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0082",
          "start": 3191,
          "end": 3228,
          "text": "교육은 방식만 검토됐고 실제 일정과 250만 원 승인은 아직입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a3f37008-d5d1-59d3-8fcb-b5bbfae18cb5",
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0083",
          "start": 3229,
          "end": 3251,
          "text": "영업 담당자: 그렇게 이해하시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a3f37008-d5d1-59d3-8fcb-b5bbfae18cb5",
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0084",
          "start": 3252,
          "end": 3311,
          "text": "결제 연동은 CRM 계약에 포함되지 않았고, 상담사 교육도 실제 진행이나 비용 승인이 완료되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a3f37008-d5d1-59d3-8fcb-b5bbfae18cb5",
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
