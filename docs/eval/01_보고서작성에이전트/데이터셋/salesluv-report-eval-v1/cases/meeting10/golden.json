      "source_refs": [
        {
          "path": "transcripts/meeting10.txt",
          "start": 2673,
          "end": 2733,
          "quote": "영업 쪽에서는 6월 11일까지 자동 갱신과 계약 종료 시 데이터 반출에 관한 조항 초안을 보내 드리겠습니다.",
          "segment_ids": [
            "S0062"
