        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0079",
          "start": 3269,
          "end": 3288,
          "text": "류온재: 네, 그 부분은 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
