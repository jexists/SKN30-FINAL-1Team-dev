        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0077",
          "start": 3152,
          "end": 3184,
          "text": "다만 지급 조건과 조항을 검토 중이라 아직 서명 전입니다."
