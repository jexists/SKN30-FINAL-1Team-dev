            "cbef8e0a-62d2-5788-baa4-a0e736551385"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0080",
          "start": 3289,
          "end": 3338,
          "text": "저는 초안을 받은 뒤 대표에게 전달하고, 서명 여부는 대표 확인 후 따로 연락하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11",
            "cbef8e0a-62d2-5788-baa4-a0e736551385"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0081",
          "start": 3339,
          "end": 3404,
          "text": "장비 대장은 설치일 원본문서를 찾지 못해 설치일과 보증 상태를 아직 확정할 수 없고, 원본과 보증 확인이 필요합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11",
            "cbef8e0a-62d2-5788-baa4-a0e736551385"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0082",
          "start": 3405,
