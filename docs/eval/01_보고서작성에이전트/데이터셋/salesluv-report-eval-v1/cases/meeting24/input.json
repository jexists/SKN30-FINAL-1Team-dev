        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0075",
          "start": 3059,
          "end": 3084,
          "text": "영업 담당자: 오늘 확인한 내용은 이렇습니다."
