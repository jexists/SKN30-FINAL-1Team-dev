        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e5aeb77a-a489-5410-9ca2-9e1e0e15fc11"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0073",
          "start": 2944,
          "end": 2979,
          "text": "장비 대장과 야간지원의 구체 조건은 아직 따로 검토해야 합니다."
