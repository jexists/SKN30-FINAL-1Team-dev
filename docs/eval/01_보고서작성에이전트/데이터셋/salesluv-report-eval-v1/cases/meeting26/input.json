        }
      },
      {
        "segment": {
          "segment_id": "S0029",
          "start": 1197,
          "end": 1248,
          "text": "사업팀은 다음 달 주요 프로젝트를 우선 관리해 보고 싶지만, 재무팀 결재는 아직 안 났어요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0030",
          "start": 1249,
          "end": 1276,
          "text": "현재 제안은 몇 명 기준이고 금액이 어떻게 되죠?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0031",
          "start": 1277,
          "end": 1315,
          "text": "영업 담당자: 현재 제안은 18명 기준이며 연 3,200만 원입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0032",
          "start": 1316,
          "end": 1361,
          "text": "이 조건은 재무 검토 중이고, 아직 계약이나 서명 단계로 넘어간 상태는 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0033",
          "start": 1362,
          "end": 1416,
          "text": "사업팀이 우선 관리하려는 방향과 비용 검토는 함께 진행되고 있지만, 비용 승인이 먼저 필요합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0034",
          "start": 1417,
          "end": 1435,
          "text": "백도하: 예산 심사일은 잡혔나요?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0035",
          "start": 1436,
          "end": 1479,
          "text": "계약 시점과 함께 내부에 설명해야 해서, 대략적인 날짜라도 있으면 좋겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0036",
          "start": 1480,
          "end": 1522,
          "text": "영업 담당자: 현재로서는 예산 심사일과 계약 일정 모두 확정되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0037",
          "start": 1523,
          "end": 1564,
          "text": "재무팀이 제안을 검토하고 있는 상태라 날짜를 정해 말씀드리기는 어렵습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0038",
          "start": 1565,
          "end": 1605,
          "text": "재무 검토가 어디까지 진행됐는지와 별개로, 서명이 완료된 것은 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0039",
          "start": 1606,
          "end": 1639,
          "text": "백도하: 그 상태를 제가 6월 22일까지 확인해 보겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0040",
          "start": 1640,
          "end": 1709,
          "text": "보안 결재는 승인됐는지 여부만이 아니라 지금 어느 단계에 멈췄는지도 보고, 재무 검토도 같은 방식으로 확인해서 알려드릴게요."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0041",
          "start": 1710,
          "end": 1723,
          "text": "영업 담당자: 좋습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0042",
          "start": 1724,
          "end": 1768,
          "text": "6월 22일까지 보안 결재와 재무 검토 상태를 확인하시는 것으로 이해하겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0043",
          "start": 1769,
          "end": 1858,
          "text": "그때 승인 여부가 아직 나오지 않았더라도 현재 담당 단계와 멈춘 지점을 알려주시면, 화면에서 확인된 내용과 실제 자료 반입 상태를 나누어 살펴볼 수 있겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0044",
          "start": 1859,
          "end": 1866,
          "text": "백도하: 네."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0045",
          "start": 1867,
          "end": 1893,
          "text": "운영자료는 그때까지도 계속 반입하지 않겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0046",
          "start": 1894,
          "end": 1971,
          "text": "가상 자료로 확인할 수 있는 다운로드 제한과 이력 검증은 유지하고, 실제 도면과 계약 자료는 보안 결재가 끝난 뒤에야 다시 검토하겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      }
    ]
