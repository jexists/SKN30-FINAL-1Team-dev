        {
          "path": "transcripts/meeting01.txt",
          "start": 1835,
          "end": 1891,
          "quote": "영업본부장 검토와 재무책임자 예산 승인이 남아 있으며, 오늘 논의만으로 구매가 확정된 것은 아닙니다.",
          "segment_ids": [
            "S0038"
          ]
        }
