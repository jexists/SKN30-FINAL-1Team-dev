  "facts": [
    {
      "id": "meeting01-f01",
      "claim": "생산지시가 아닌 견적 버전과 승인 이력 관리가 이번 검토 목적입니다.",
      "sales_deal_id": null,
      "scope": "meeting_context",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 8,
          "end": 78,
          "quote": "오늘은 생산지시를 새로 설계하는 자리가 아니라, 견적의 버전과 승인 이력을 어떻게 관리할지 확인하는 자리로 이해하고 왔습니다.",
          "segment_ids": [
            "S0001"
          ]
        },
        {
          "path": "transcripts/meeting01.txt",
          "start": 124,
          "end": 159,
          "quote": "생산지시를 이 화면에서 내리는 요구는 현재 없다고 보면 될까요?",
          "segment_ids": [
            "S0002"
          ]
        }
      ],
      "importance": "required",
      "event_id": "meeting01-f01"
    },
    {
      "id": "meeting01-f02",
      "claim": "견적 회신 중앙값은 2일이며 시범 운영 목표는 1일 이내입니다.",
      "sales_deal_id": "deal01-1",
      "scope": "deal",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 711,
          "end": 779,
          "quote": "지난달 완료한 견적 스무 건을 기준으로 요청을 받은 시점부터 고객에게 보낸 시점까지를 확인해 보니 중앙값이 이틀이었습니다.",
          "segment_ids": [
            "S0014"
          ]
        },
        {
          "path": "transcripts/meeting01.txt",
          "start": 820,
          "end": 869,
          "quote": "시범 운영에서는 같은 기준으로 회신 시간을 보면서 하루 이내인지 확인하는 것이 목표군요.",
          "segment_ids": [
            "S0016"
          ]
        }
      ],
      "importance": "required",
      "event_id": "meeting01-f02"
    },
    {
      "id": "meeting01-f03",
      "claim": "초기 유료 사용자는 25명이 아니라 내부 영업 20명입니다.",
      "sales_deal_id": "deal01-1",
      "scope": "deal",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 1230,
          "end": 1255,
          "quote": "초기 유료 사용자는 내부 영업 스무 명입니다.",
          "segment_ids": [
            "S0025"
          ]
        },
        {
          "path": "transcripts/meeting01.txt",
          "start": 1304,
          "end": 1347,
          "quote": "현재 사용자 수는 외부 대리점 다섯 명을 제외한 내부 영업 20명으로 봅니다.",
          "segment_ids": [
            "S0027"
          ]
        }
      ],
      "importance": "required",
      "event_id": "meeting01-f03"
    },
    {
      "id": "meeting01-f04",
      "claim": "CRM 검토 상한은 부가세 별도 연 2,400만 원이며 구매 승인은 나지 않았습니다.",
      "sales_deal_id": "deal01-1",
      "scope": "deal",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 1542,
          "end": 1595,
          "quote": "2,400만 원은 승인된 예산이 아니라 CRM 기본 도입에 대한 내부 검토 상한으로 보겠습니다.",
          "segment_ids": [
            "S0032"
          ]
        },
        {
          "path": "transcripts/meeting01.txt",
          "start": 1596,
          "end": 1653,
          "quote": "ERP 연동비와 교육비는 별도 항목이며, 모든 비용을 그 금액 안에 넣는 조건으로 이해하지 않겠습니다.",
          "segment_ids": [
            "S0033"
          ]
        }
      ],
      "importance": "required",
      "event_id": "meeting01-f04"
    },
    {
      "id": "meeting01-f05",
      "claim": "ERP 연동 요구는 단가·유효기간 조회이며 원가 수정과 재고 차감은 범위 밖입니다.",
      "sales_deal_id": "deal01-2",
      "scope": "deal",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 2275,
          "end": 2323,
          "quote": "읽기 전용 연동으로 범위를 제한하고, 단가와 유효기간을 조회하는 흐름만 확인하겠습니다.",
          "segment_ids": [
            "S0048"
          ]
        }
      ],
      "importance": "required",
      "event_id": "meeting01-f05"
    },
    {
      "id": "meeting01-f06",
      "claim": "ERP 테스트 자료 요청 담당자는 고은서이며 전달 기한은 미정입니다.",
      "sales_deal_id": "deal01-2",
      "scope": "deal",
      "source_refs": [
        {
          "path": "transcripts/meeting01.txt",
          "start": 2761,
          "end": 2829,
          "quote": "고은서님이 ERP 담당자에게 비식별 테스트 품번 세 개와 단가 변경 이력 예시를 요청한 상태이며, 전달 기한은 미정입니다.",
          "segment_ids": [
            "S0058"
          ]
        },
        {
          "path": "transcripts/meeting01.txt",
          "start": 2830,
          "end": 2873,
          "quote": "자료가 도착하기 전에는 연동 방식이나 API 제공 여부를 확정하지 않겠습니다.",
          "segment_ids": [
            "S0059"
          ]
        }
