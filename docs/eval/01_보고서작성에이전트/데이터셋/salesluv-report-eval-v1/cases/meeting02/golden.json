        {
          "path": "transcripts/meeting02.txt",
          "start": 1101,
          "end": 1146,
          "quote": "화주별로 누가 어디까지 볼 수 있는지 접근 권한을 나누는 방안을 검토해야 합니다.",
          "segment_ids": [
            "S0022"
          ]
