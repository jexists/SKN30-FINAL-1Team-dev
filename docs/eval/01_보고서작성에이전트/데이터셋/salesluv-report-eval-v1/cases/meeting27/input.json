        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0027",
          "start": 1137,
          "end": 1160,
          "text": "진해온: 그 부분은 별도로 보고 있습니다."
