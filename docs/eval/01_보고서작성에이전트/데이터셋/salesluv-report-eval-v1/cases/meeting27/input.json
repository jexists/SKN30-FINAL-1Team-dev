        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0044",
          "start": 1934,
          "end": 1962,
          "text": "6월 22일까지 두 조건에 대한 답을 보내 주세요."
