        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0032",
          "start": 1397,
          "end": 1406,
          "text": "진해온: 맞아요."
