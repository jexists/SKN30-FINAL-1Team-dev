        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0024",
          "start": 989,
          "end": 999,
