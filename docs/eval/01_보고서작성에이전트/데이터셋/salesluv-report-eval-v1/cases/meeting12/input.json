    "transcript_sha256": "1a8e24f782765b2a2f28ab39b732053a8ba5be9109b3b8c986043f74698d377f",
    "selected_deal_ids": [
      "6ca8c414-0109-5efa-b007-5d809037d282",
      "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0",
      "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
    ],
    "items": [
      {
        "segment": {
          "segment_id": "S0001",
          "start": 0,
          "end": 78,
          "text": "영업 담당자: 오늘은 보안 검토 보완 사항과 비식별 상담 화면 확인 결과를 먼저 보고, 주문·반품 연동과 야간 운영지원도 이어서 이야기하죠."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0",
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0002",
          "start": 79,
          "end": 96,
          "text": "보안 문서는 어떻게 진행됐나요?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0",
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0003",
          "start": 97,
          "end": 176,
          "text": "서이든: 문서는 6월 5일에 전달했고 검토 접수까지 됐지만, 다운로드 이력과 관리자 접근기록의 보관기간을 더 설명해 달라는 회신을 받았습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0004",
          "start": 177,
          "end": 192,
          "text": "현재는 보안 승인 전입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0005",
          "start": 193,
          "end": 256,
          "text": "영업 담당자: 보안 검토는 접수됐지만 승인 전이며, 다운로드 이력과 관리자 접근기록의 보관기간 보완이 필요합니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0006",
          "start": 257,
          "end": 296,
          "text": "실데이터를 반입하거나 고객정보를 사용하는 단계로 넘어간 것은 아닙니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0007",
          "start": 297,
          "end": 346,
          "text": "서이든: 지금까지 화면에서 본 것은 실제 고객정보가 아니라 비식별 상담 열다섯 건입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0008",
          "start": 347,
          "end": 393,
          "text": "그 자료로 시범 화면만 확인했으며, 보안 승인이나 실제 운영은 완료되지 않았습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0009",
          "start": 394,
          "end": 441,
          "text": "영업 담당자: 보안 접근기록 보관기간 문서 회신이 우선이며 기한은 6월 12일입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0010",
          "start": 442,
          "end": 475,
          "text": "실데이터 반입을 막고 있는 사항도 아직 해소되지 않았습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0011",
          "start": 476,
          "end": 518,
          "text": "서이든: 6월 12일이라는 기한은 보안 접근기록 보관기간 문서에 해당합니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0012",
          "start": 519,
          "end": 557,
          "text": "야간 운영지원 설명과 상담 통합 화면의 시범 확인은 별도 과제입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0013",
          "start": 558,
          "end": 630,
          "text": "영업 담당자: 보안 쪽은 보관기간 문서 회신 여부를 확인하고, 상담 통합 화면은 비식별 자료에서 주문번호 연결 여부를 확인합니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0014",
          "start": 631,
          "end": 671,
          "text": "실제 상담 응답시간이나 고객 만족도는 이번 자료에서 측정하지 않았습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0015",
          "start": 672,
          "end": 750,
          "text": "서이든: 상담 통합 화면에서는 열다섯 건 가운데 열네 건이 이전 상담과 연결됐고, 한 건은 주문번호 앞자리 공백 때문에 검색되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0016",
          "start": 751,
          "end": 769,
          "text": "현재 전체 성공 상태는 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0017",
          "start": 770,
          "end": 830,
          "text": "영업 담당자: 비식별 상담 열다섯 건 중 열네 건이 연결됐고, 한 건은 주문번호 공백으로 미연결 상태입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0018",
          "start": 831,
          "end": 875,
          "text": "해당 건을 수정한 뒤 다시 확인해야 하므로 현재 성공률은 백 퍼센트가 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0019",
          "start": 876,
          "end": 912,
          "text": "서이든: 오류를 고칠 때는 주문번호 앞뒤의 공백만 정리해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0020",
          "start": 913,
          "end": 943,
          "text": "주문번호 가운데 들어간 문자는 그대로 보존해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0021",
          "start": 944,
          "end": 985,
          "text": "전화번호가 같다는 이유로 주문번호가 다른 문의를 하나로 합치면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0022",
          "start": 986,
          "end": 1024,
          "text": "영업 담당자: 앞뒤 공백만 제거하고 가운데 문자는 손대지 않겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0023",
          "start": 1025,
          "end": 1063,
          "text": "또 전화번호가 같아도 주문번호가 다르면 별도의 문의로 유지하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0024",
          "start": 1064,
          "end": 1090,
          "text": "연결 기준을 전화번호 하나로 넓히지 않겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0025",
          "start": 1091,
          "end": 1149,
          "text": "서이든: 이번에는 공백이 들어간 주문번호 한 건만 먼저 수정한 뒤, 열다섯 건 전체를 다시 돌려 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0026",
          "start": 1150,
          "end": 1198,
          "text": "기존에 정상적으로 연결됐던 열네 건이 수정 과정에서 깨지지 않는지도 함께 봐야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0027",
          "start": 1199,
          "end": 1209,
          "text": "영업 담당자: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0028",
          "start": 1210,
          "end": 1277,
          "text": "해당 주문번호의 공백 오류를 수정하고, 전체 열다섯 건을 다시 검색해 기존 연결 열네 건의 유지 여부까지 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0029",
          "start": 1278,
          "end": 1319,
          "text": "수정 결과와 처음 오류가 재현되는 방법을 6월 12일까지 전달드리겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0030",
          "start": 1320,
          "end": 1353,
          "text": "서이든: 지금은 수정 예정 단계이며 완료된 결과가 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0031",
          "start": 1354,
          "end": 1386,
          "text": "6월 12일 결과를 보내기 전까지는 재검증 전 상태입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0032",
          "start": 1387,
          "end": 1443,
          "text": "영업 담당자: 현재 확인된 상태는 상담 화면의 기존 열네 건 연결과 주문번호 공백 오류 한 건입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0033",
          "start": 1444,
          "end": 1463,
          "text": "전체 재검증은 아직 수행 전입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0034",
          "start": 1464,
          "end": 1488,
          "text": "서이든: 재검증 방식도 정해 두고 싶습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0035",
          "start": 1489,
          "end": 1533,
          "text": "상담사 두 명이 같은 열다섯 건을 검색하되, 서로 다른 순서로 찾게 해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0036",
          "start": 1534,
          "end": 1578,
          "text": "한 사람이 먼저 본 화면을 다른 사람이 그대로 따라 하는 방식은 피해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0037",
          "start": 1579,
          "end": 1650,
          "text": "영업 담당자: 상담사 두 명이 각자 다른 순서로 열다섯 건을 검색하는 시험은 아직 예약된 절차이고, 검색 결과는 수집 전입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0038",
          "start": 1651,
          "end": 1680,
          "text": "먼저 본 화면을 그대로 따라 하는 방식은 제외합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0039",
          "start": 1681,
          "end": 1710,
          "text": "서이든: 일반 상담원이 보는 범위도 확인해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0040",
          "start": 1711,
          "end": 1738,
          "text": "문의 내용과 주문번호만 조회할 수 있으면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0041",
          "start": 1739,
          "end": 1802,
          "text": "원본 결제수단 상세는 보여 주지 말고, 조회 권한이 없는 항목은 빈 칸으로 두기보다 권한이 없다고 안내해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0042",
          "start": 1803,
          "end": 1864,
          "text": "영업 담당자: 일반 상담원 화면에는 문의 내용과 주문번호만 조회 대상으로 두고 결제수단 상세는 제외하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0043",
          "start": 1865,
          "end": 1939,
          "text": "권한이 없는 정보는 값이 비어 있는 것처럼 보이게 하지 않고, 권한이 없어 확인할 수 없다는 안내를 표시하는 방향으로 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0044",
          "start": 1940,
          "end": 2018,
          "text": "서이든: 전화와 온라인 상담을 주문과 연결해 중복 문의를 줄이는 화면이지만, 이번 확인에서는 응답시간이나 고객 만족도를 측정하지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0045",
          "start": 2019,
          "end": 2072,
          "text": "영업 담당자: 이번 상담 통합 화면에서 확인한 것은 비식별 상담의 연결 여부와 조회 범위입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0046",
          "start": 2073,
          "end": 2105,
          "text": "실제 상담 응답시간이나 고객 만족도는 측정하지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0047",
          "start": 2106,
          "end": 2127,
          "text": "서이든: 이제 주문·반품 연동을 보죠."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0048",
          "start": 2128,
          "end": 2207,
          "text": "같은 주문의 두 품목을 나눠 반품하는 화면과 요청 메시지는 확인했지만, 결제사 테스트 계정이 없어서 지급 완료 응답까지 시험한 것은 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0049",
          "start": 2208,
          "end": 2259,
          "text": "영업 담당자: 환불 요청 생성과 결제 시스템의 환불 지급 완료 응답은 서로 다른 상태입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0050",
          "start": 2260,
          "end": 2309,
          "text": "환불 요청 화면과 요청 메시지는 확인했지만, 지급 완료 응답은 아직 검증되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0051",
          "start": 2310,
          "end": 2379,
          "text": "서이든: 주문 상태와 반품 접수 이력을 연결하는 부분은 확인 대상이지만, 환불 지급 확정은 결제 시스템에서 확인해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0052",
          "start": 2380,
          "end": 2414,
          "text": "현재 결제사 계정이 없어 연동 기능검증은 완료되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0053",
          "start": 2415,
          "end": 2472,
          "text": "영업 담당자: 주문·반품 화면에서 요청 접수와 이력 연결은 확인했지만, 지급 완료 연동은 미검증입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0054",
          "start": 2473,
          "end": 2509,
          "text": "결제사 응답을 직접 확인하지 못해 기능검증은 완료되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0055",
          "start": 2510,
          "end": 2535,
          "text": "서이든: 검증 사례는 두 가지로 나눠 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0056",
          "start": 2536,
          "end": 2620,
          "text": "같은 반품 접수를 세 번 재전송하는 경우에는 접수 하나로 남아야 하고, 서로 다른 두 품목을 각각 반품하는 경우에는 접수 두 개가 모두 남아야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0057",
          "start": 2621,
          "end": 2713,
          "text": "영업 담당자: 같은 반품의 세 번 재전송은 하나의 접수로 처리되는지, 서로 다른 두 품목을 한 번씩 요청하는 경우에는 두 접수가 각각 남는지를 분리해 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0058",
          "start": 2714,
          "end": 2735,
          "text": "두 사례를 한 결과로 섞지 않겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0059",
          "start": 2736,
          "end": 2761,
          "text": "서이든: 금액 조건도 시험값으로 넣어 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0060",
          "start": 2762,
          "end": 2822,
          "text": "가상 주문 총액은 60,000원이고, 그중 20,000원인 상품 한 개를 먼저 부분반품 요청하는 조건입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0061",
          "start": 2823,
          "end": 2870,
          "text": "요청액은 20,000원으로 남고 나머지 40,000원은 그대로 유지되는지 보겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0062",
          "start": 2871,
          "end": 2963,
          "text": "영업 담당자: 가상 시험에서는 총 60,000원 주문에서 20,000원 상품 한 개를 부분반품 요청하고, 요청액 20,000원과 남은 40,000원을 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0063",
          "start": 2964,
          "end": 3004,
          "text": "이것은 시험값에 대한 검증이며, 실제 환불을 완료했다는 의미는 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0064",
          "start": 3005,
          "end": 3060,
          "text": "서이든: 상품 판매가격을 직접 바꾸거나 이미 지급된 환불 내역을 수정하는 권한은 필요하지 않습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0065",
          "start": 3061,
          "end": 3118,
          "text": "이번 범위는 조회와 반품 요청 화면이고, 결제사 응답은 읽어서 상태를 표시하는 수준으로 검토해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0066",
          "start": 3119,
          "end": 3167,
          "text": "영업 담당자: 상품 판매가격과 기지급 환불 내역의 직접 수정은 범위에서 제외하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0067",
          "start": 3168,
          "end": 3238,
          "text": "조회와 반품 요청 화면을 중심으로 보고, 결제사 응답을 받게 되는 경우에도 그 상태를 읽어 표시하는 방향으로만 검토하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0068",
          "start": 3239,
          "end": 3301,
          "text": "서이든: 60,000원에서 20,000원을 요청한 것은 환불 요청 생성 상태이며, 지급 완료 상태와는 다릅니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0069",
          "start": 3302,
          "end": 3329,
          "text": "현재 실제 환불 지급 완료는 확인되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0070",
          "start": 3330,
          "end": 3340,
          "text": "영업 담당자: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0071",
          "start": 3341,
          "end": 3408,
          "text": "20,000원 부분반품 요청이 생성된 상태와 결제 시스템에서 지급 완료가 확인된 상태를 서로 다른 단계로 표시하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0072",
          "start": 3409,
          "end": 3454,
          "text": "현재는 결제사 테스트가 없으므로 지급 완료 상태는 확인하지 못한 것으로 남깁니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0073",
          "start": 3455,
          "end": 3489,
          "text": "서이든: 야간 운영지원은 아직 계약을 결정한 내용이 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0074",
          "start": 3490,
          "end": 3585,
          "text": "야간마다 상담원이 상주하는 서비스의 계약이나 금액, 운영 시간은 정하지 않았고, 우선 야간 문의를 다음 날 담당자에게 넘기는 방식과 장애 때 연락할 체계를 보고 싶습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0075",
          "start": 3586,
          "end": 3661,
          "text": "영업 담당자: 야간 운영지원은 상주 서비스의 계약 조건을 확정하는 단계가 아니라 인계와 장애 연락체계를 검토하는 단계로 이해하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0076",
          "start": 3662,
          "end": 3714,
          "text": "월 비용이나 서비스 시간, 상주 여부를 새로 정하지 않고 필요한 운영 흐름만 설명드리겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0077",
          "start": 3715,
          "end": 3761,
          "text": "서이든: 야간 접수는 다음 근무가 시작될 때 담당자를 배정하는 안을 검토해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0078",
          "start": 3762,
          "end": 3822,
          "text": "자동 접수 안내가 고객에게 발송됐다고 해서 그 문의에 실제 답변한 것으로 보거나 문의를 종결하면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0079",
          "start": 3823,
          "end": 3872,
          "text": "영업 담당자: 야간 접수는 다음 근무 시작 시 담당자를 배정하는 방안으로 검토하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0080",
          "start": 3873,
          "end": 3933,
          "text": "자동 접수 안내를 보낸 시각과 실제 문의에 답변한 시각은 구분하고, 안내 발송만으로 문의를 닫지 않겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0081",
          "start": 3934,
          "end": 3987,
          "text": "서이든: 인계 목록에는 접수 시각, 아직 처리되지 않은 이유, 확인할 담당 부서를 보여 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0082",
          "start": 3988,
          "end": 4040,
          "text": "개인 담당자의 이름을 바로 정하지 못하더라도 부서까지만 적고 나중에 배정할 수 있으면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0083",
          "start": 4041,
          "end": 4101,
          "text": "영업 담당자: 인계 목록에는 접수 시각과 미완료 이유, 확인할 담당 부서를 포함하는 방향으로 검토하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0084",
          "start": 4102,
          "end": 4173,
          "text": "개인 담당자가 아직 정해지지 않은 경우에는 이름을 임의로 넣지 않고 부서 수준으로 남긴 뒤 추후 배정하는 방식도 허용하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0085",
          "start": 4174,
          "end": 4238,
          "text": "서이든: 반품 요청처럼 야간에 접수됐지만 다음 날 담당자에게 넘어가지 않고 남는 상황도 목록에서 확인되어야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0086",
          "start": 4239,
          "end": 4275,
          "text": "그때도 접수 시각과 미완료 사유, 확인 부서가 빠지면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0087",
          "start": 4276,
          "end": 4331,
          "text": "영업 담당자: 다음 근무로 넘어가지 않은 야간 접수도 인계 목록에서 누락되지 않도록 검토하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0088",
          "start": 4332,
          "end": 4404,
          "text": "해당 항목에는 접수 시각, 미완료 이유, 확인할 담당 부서를 남기고, 담당자 이름이 미정이면 부서만 표시하는 조건으로 보겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0089",
          "start": 4405,
          "end": 4434,
          "text": "서이든: 야간지원은 다음 미팅에서 설명받아도 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0090",
          "start": 4435,
          "end": 4499,
          "text": "보안 문서와 상담 통합 화면 재확인이 우선이며, 야간지원은 아직 검토 중이고 다른 화면의 확인 상태와는 별개입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0091",
          "start": 4500,
          "end": 4578,
          "text": "영업 담당자: 보안 접근기록 보관기간 문서 회신과 상담 화면의 주문번호 공백 수정 및 열다섯 건 전체 재확인은 각각 별도의 확인 사항입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282",
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0092",
          "start": 4579,
          "end": 4607,
          "text": "야간 인계와 장애 연락체계는 아직 검토 항목입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282",
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0093",
          "start": 4608,
          "end": 4660,
          "text": "서이든: 보안 검토는 접수됐지만 다운로드·관리자 접근기록 보관기간 보완 전이라 승인 전입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0094",
          "start": 4661,
          "end": 4702,
          "text": "상담 통합은 열다섯 건 중 열네 건이 연결됐고 한 건은 재확인 대상입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0095",
          "start": 4703,
          "end": 4713,
          "text": "영업 담당자: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0096",
          "start": 4714,
          "end": 4780,
          "text": "상담 통합 쪽은 주문번호 앞뒤 공백만 정리하고 가운데 문자는 보존하며, 전화번호가 같아도 다른 주문을 합치지 않습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0097",
          "start": 4781,
          "end": 4846,
          "text": "6월 12일까지 수정 결과와 오류 재현 방법을 전달하고, 이후 열다섯 건 전체를 다시 확인하는 일정으로 이해했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0098",
          "start": 4847,
          "end": 4908,
          "text": "서이든: 주문·반품 쪽은 부분반품 요청 화면은 확인했지만 결제사 테스트가 없어 지급 완료 연동은 미검증입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0099",
          "start": 4909,
          "end": 5007,
          "text": "같은 접수 세 번과 서로 다른 품목 두 건을 구분하고, 60,000원 시험주문에서 20,000원 요청과 40,000원 잔액을 확인하되 실제 환불 완료로 말하지 않는 조건입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0100",
          "start": 5008,
          "end": 5086,
          "text": "영업 담당자: 그리고 상품 판매가격이나 이미 지급된 환불 내역을 직접 수정하지 않고, 결제사 응답은 읽어 상태를 표시하는 범위로 두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282",
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0101",
          "start": 5087,
          "end": 5145,
          "text": "일반 상담원은 문의와 주문번호만 조회하고 결제수단 상세는 제외하며, 권한이 없다는 안내를 사용하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282",
            "34e4bfdc-0cc0-5ea3-984a-1067d59ea8b0"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0102",
          "start": 5146,
          "end": 5200,
          "text": "서이든: 야간 운영지원은 상주 계약이나 금액·시간 확정이 아니라 인계와 장애 연락체계 검토입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0103",
          "start": 5201,
          "end": 5248,
          "text": "자동 접수 안내는 문의 종결이 아니며, 다음 근무 시작 때 배정하는 안을 검토합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0104",
          "start": 5249,
          "end": 5283,
          "text": "인계 목록에는 접수 시각, 미완료 이유, 확인 부서를 둡니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "b7198d85-c5b1-5449-8475-44ad64cbd6a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0105",
          "start": 5284,
          "end": 5349,
          "text": "영업 담당자: 상담사 두 명이 서로 다른 순서로 비식별 상담 열다섯 건을 검색하는 재검증은 아직 결과 수집 전입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0106",
          "start": 5350,
          "end": 5393,
          "text": "현재 확인된 것은 열네 건 연결이며, 전체 재검증은 아직 완료되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "6ca8c414-0109-5efa-b007-5d809037d282"
          ]
        }
      }
    ]
