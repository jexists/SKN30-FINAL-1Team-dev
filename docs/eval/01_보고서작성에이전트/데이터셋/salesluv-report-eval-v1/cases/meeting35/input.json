        }
      },
      {
        "segment": {
          "segment_id": "S0074",
          "start": 2797,
          "end": 2834,
          "text": "백도하: 자료 전환은 도면과 계약서를 제외한 제한 시범 범위입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "41f27fcd-7e27-56a5-9b8e-7c00321f3787",
            "b64a61e9-e961-5a35-b788-258dea5d9621",
            "e1dd51d7-495c-56a9-9b39-40a96c0fcb57"
