        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0036",
          "start": 1527,
          "end": 1554,
          "text": "계약서에 서명할 사람도 아직 정해지지 않았습니다."
