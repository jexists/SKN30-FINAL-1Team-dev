        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0034",
          "start": 1461,
          "end": 1483,
          "text": "문시우: 재무팀 결재는 아직 안 났어요."
