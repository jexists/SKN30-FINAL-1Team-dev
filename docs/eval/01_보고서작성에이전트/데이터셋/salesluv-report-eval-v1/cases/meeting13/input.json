        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0028",
          "start": 1265,
          "end": 1275,
          "text": "문시우: 좋습니다."
