          "text": "계약 초안에는 말씀드린 열 명, 1,800만 원, 7월 1일 개시 예정일을 넣어 확인할 수 있게 하겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0062",
          "start": 2735,
          "end": 2767,
          "text": "문시우: 교육안은 아직 발주서가 아니라 검토 자료인 거죠."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0063",
          "start": 2768,
          "end": 2791,
          "text": "받아본 뒤에 일정과 비용을 판단하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0064",
          "start": 2792,
          "end": 2805,
          "text": "영업 담당자: 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0065",
          "start": 2806,
          "end": 2842,
          "text": "교육안 전달은 발주나 시행 확정이 아니라 검토를 위한 자료입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0066",
          "start": 2843,
          "end": 2881,
          "text": "두 그룹의 실습 내용과 조건을 확인한 뒤 판단하는 단계로 두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0067",
          "start": 2882,
          "end": 2936,
          "text": "문시우: CRM 쪽은 열두 건의 표본 결과, 예산 승인 요청 상태, 결제 정보 구분이 핵심입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0068",
          "start": 2937,
          "end": 2972,
          "text": "특히 결재 중인 요청서를 승인 완료처럼 읽히게 하면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0069",
          "start": 2973,
          "end": 3004,
          "text": "영업 담당자: 현재 CRM 관련 상태는 그렇게 나뉩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0070",
          "start": 3005,
          "end": 3060,
          "text": "열두 건에서는 담당자와 제공된 연락일 누락이 없었고, 연락일 미정 두 건은 미정으로 남아 있습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0071",
          "start": 3061,
          "end": 3109,
          "text": "예산 1,800만 원 요청은 제출됐지만 결재 중이며, 계약은 아직 체결되지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0072",
          "start": 3110,
          "end": 3195,
          "text": "문시우: 결제 건은 상담 메모에 남은 고객 발언과 실제 성공 응답을 서로 다른 정보로 봐야 하고, 연동 검증 전에는 회계 담당자 확인도 계속 필요합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0073",
          "start": 3196,
          "end": 3222,
          "text": "이 조건까지 포함되어야 내부 검토가 가능합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0074",
          "start": 3223,
          "end": 3247,
          "text": "영업 담당자: 그 구분을 전제로 하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0075",
          "start": 3248,
          "end": 3330,
          "text": "고객이 결제했다고 말한 기록은 메모에 남기되 실제 결제완료는 성공 응답으로 따로 확인하고, 연동 검증 전에는 회계 담당자의 확인 절차를 유지합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0076",
          "start": 3331,
          "end": 3341,
          "text": "문시우: 좋습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0077",
          "start": 3342,
          "end": 3420,
          "text": "그럼 제가 받을 문서는 검토용 계약 초안과 두 그룹으로 구분된 교육안이고, 이후 재무팀에는 현재 결재 중인 예산 요청과 함께 전달하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0078",
          "start": 3421,
          "end": 3445,
          "text": "다만 결재가 끝났다고 단정할 수는 없습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "e87a886e-31a5-5620-860a-527d02055a31"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0079",
          "start": 3446,
          "end": 3456,
          "text": "영업 담당자: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0080",
          "start": 3457,
          "end": 3517,
          "text": "6월 12일까지 계약 초안과 교육안을 전달드리고, 내부에서는 수신한 항목을 확인해 재무팀에 넘기시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0081",
          "start": 3518,
          "end": 3593,
          "text": "계약 체결과 교육 발주는 각각 아직 확정되지 않은 상태로 두고, CRM의 표본 확인 결과와 결제 확인 절차도 별도로 검토하시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "33fdda96-b0ec-5ad0-99f3-192e905679a5"
          ]
        }
      }
    ]
