        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0042",
          "start": 1787,
          "end": 1808,
          "text": "영업 담당자: 그 점을 구분하겠습니다."
