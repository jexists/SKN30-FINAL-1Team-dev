        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "788723af-dea7-5981-af8c-f268c44bdfa5"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0070",
          "start": 3002,
          "end": 3022,
          "text": "장하람: 그 정도로 정리하면 됩니다."
