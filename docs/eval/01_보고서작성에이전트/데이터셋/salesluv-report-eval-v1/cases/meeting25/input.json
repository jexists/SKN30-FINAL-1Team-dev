            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0018",
          "start": 888,
          "end": 895,
          "text": "민채원: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0019",
          "start": 896,
          "end": 922,
          "text": "아직 어느 안으로 구매할지 결정하지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0020",
          "start": 923,
          "end": 987,
          "text": "가격이 부담돼서만 미루는 것은 아니고, 점주가 무엇을 직접 처리할지 본사에서 어디까지 대신할지부터 정리해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0021",
          "start": 988,
          "end": 1056,
          "text": "영업 담당자: 그렇다면 점주 계정이 없는 동안에는 본사 담당자가 점주의 요청을 대신 입력하는 흐름을 전제로 살펴봐야겠네요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0022",
          "start": 1057,
          "end": 1138,
          "text": "그 경우 본사 사용자는 요청을 등록할 때 어느 점포의 건인지 구분할 수 있어야 할 텐데, 그 부분은 교육에서 실제로 다뤄야 할 항목으로 보입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0023",
          "start": 1139,
          "end": 1156,
          "text": "민채원: 그 부분이 중요합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0024",
          "start": 1157,
          "end": 1207,
          "text": "점주가 직접 입력하지 않는 기간에는 본사 담당자가 여러 점포의 요청을 대신 넣게 되니까요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0025",
          "start": 1208,
          "end": 1256,
          "text": "담당자가 입력 화면에서 해당 요청이 어느 점포의 것인지 선택하는 절차를 익혀야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0026",
          "start": 1257,
          "end": 1336,
          "text": "영업 담당자: CRM 제안은 우선 본사 열두 명이 사용하는 조건과, 나중에 점주 계정을 추가할 때 적용할 조건을 나누는 방식이 적절하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0027",
          "start": 1337,
          "end": 1400,
          "text": "본사만 쓰는 가격과 점주 스물네 명을 추가하는 조건을 한 덩어리로 제시하지 않고 각각 살펴볼 수 있게 하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0028",
          "start": 1401,
          "end": 1459,
          "text": "민채원: 네, 그 구분이 있어야 재무본부장님이 현재 필요한 범위와 이후 선택지를 나눠서 보실 수 있어요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0029",
          "start": 1460,
          "end": 1491,
          "text": "다만 지금 자리에서 구매 범위를 확정하는 것은 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0030",
          "start": 1492,
          "end": 1523,
          "text": "운영정책을 확인한 뒤 어느 안이 맞는지 판단해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0031",
          "start": 1524,
          "end": 1538,
          "text": "영업 담당자: 알겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0032",
          "start": 1539,
          "end": 1606,
          "text": "그러면 본사 열두 명을 먼저 사용하는 안은 현재 검토 범위로 두고, 점주 스물네 명은 추후 검토 조건으로 남겨두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0033",
          "start": 1607,
          "end": 1666,
          "text": "두 테스트에서 링크 차단이 확인됐다는 점과 계정 범위를 줄이는 판단은 서로 별개의 기준으로 설명하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0034",
          "start": 1667,
          "end": 1677,
          "text": "민채원: 좋습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0035",
          "start": 1678,
          "end": 1728,
          "text": "기술 검토가 보완됐다는 이유로 점주 계정까지 바로 시작하는 것으로 받아들여지면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0036",
          "start": 1729,
          "end": 1782,
          "text": "지금은 본사 사용자만 놓고 보는 안이고, 점주 쪽은 운영정책이 정리된 뒤 다시 보는 상황입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0037",
          "start": 1783,
          "end": 1813,
          "text": "영업 담당자: 교육 부분도 같은 범위로 맞추면 될까요?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0038",
          "start": 1814,
          "end": 1881,
          "text": "본사 담당자에게는 서로 다른 접근권한을 설명하되, 점주에게도 교육을 진행하는 일정으로 이해하면 되는지 확인하고 싶습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0039",
          "start": 1882,
          "end": 1908,
          "text": "민채원: 점주 교육은 아직 실시하지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0040",
          "start": 1909,
          "end": 1950,
          "text": "점주에게 교육한 것으로 이해되지 않도록 본사 사용자 안내만 준비해 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0041",
          "start": 1951,
          "end": 1993,
          "text": "본사 담당자 열두 명을 대상으로 한 교육안으로 다시 살펴보는 것이 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0042",
          "start": 1994,
          "end": 2033,
          "text": "영업 담당자: 네, 교육은 본사 열두 명 대상안으로만 재검토하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0043",
          "start": 2034,
          "end": 2141,
          "text": "내용은 본사 담당자와 가맹점주가 같은 화면을 보더라도 접근권한이 다를 수 있다는 점, 그리고 본사 담당자가 점포 정보를 대신 입력할 때 해당 점포를 선택하는 실습을 중심으로 잡으면 되겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0044",
          "start": 2142,
          "end": 2158,
          "text": "민채원: 그 방향이면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0045",
          "start": 2159,
          "end": 2243,
          "text": "특히 단순히 권한 차이를 설명하는 데서 끝나지 말고, 본사 담당자가 요청을 입력할 때 어느 점포의 건인지 선택하는 과정을 직접 연습할 수 있어야 해요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0046",
          "start": 2244,
          "end": 2280,
          "text": "점주가 직접 입력하는 절차를 교육하는 것은 지금 범위가 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0047",
          "start": 2281,
          "end": 2329,
          "text": "영업 담당자: 교육 날짜는 지금 정하지 않고 예산 승인 뒤에 잡는 것으로 이해했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0048",
          "start": 2330,
          "end": 2375,
          "text": "현재는 본사 사용자 안내의 대상과 필요한 실습 내용을 정리하는 단계로 두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0049",
          "start": 2376,
          "end": 2383,
          "text": "민채원: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0050",
          "start": 2384,
          "end": 2396,
          "text": "예산 승인이 먼저예요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0051",
          "start": 2397,
          "end": 2457,
          "text": "교육 날짜를 지금 잡아두면 이미 진행이 정해진 것처럼 보일 수 있으니, 승인 뒤에 일정 이야기를 하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0052",
          "start": 2458,
          "end": 2487,
          "text": "영업 담당자: 제안 자료 전달 일정도 확인하겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0053",
          "start": 2488,
          "end": 2558,
          "text": "본사 열두 명을 기준으로 한 가격과 점주를 추가할 때의 조건을 분리해서 6월 22일까지 보내 달라는 요청으로 이해하면 되나요?"
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0054",
          "start": 2559,
          "end": 2568,
          "text": "민채원: 맞아요."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0055",
          "start": 2569,
          "end": 2585,
          "text": "6월 22일까지 보내 주세요."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0056",
          "start": 2586,
          "end": 2617,
          "text": "제가 그 자료를 재무본부장님 검토회의에 올릴 예정입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0057",
          "start": 2618,
          "end": 2665,
          "text": "회의 전에 전달만 완료되면 되고, 그 자리에서 바로 결론이 난다고 보시면 안 됩니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0058",
          "start": 2666,
          "end": 2753,
          "text": "영업 담당자: 본사 열두 명 가격과 점주 추가 조건을 나누고, 현재 결정되지 않은 구매 범위와 점주 운영정책이 남아 있다는 전제를 함께 담아 전달하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50",
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0059",
          "start": 2754,
          "end": 2806,
          "text": "교육은 별도로 본사 열두 명 대상안만 검토하고, 점주 교육은 실시하지 않은 상태로 두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50",
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0060",
          "start": 2807,
          "end": 2827,
          "text": "민채원: 네, 그 구분이 정확합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50",
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0061",
          "start": 2828,
          "end": 2872,
          "text": "CRM은 본사 열두 명을 우선 보는 범위이고 점주 스물네 명은 추후 검토입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "dac86e90-364f-5740-b590-ee2d705c0e50",
            "9997f1de-d368-5518-a8e2-aa982fdb4158"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0062",
          "start": 2873,
