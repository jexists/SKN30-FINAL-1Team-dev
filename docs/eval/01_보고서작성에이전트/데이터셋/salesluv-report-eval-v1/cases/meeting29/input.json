        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0095",
          "start": 3661,
          "end": 3677,
          "text": "도윤재: 그 순서가 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
