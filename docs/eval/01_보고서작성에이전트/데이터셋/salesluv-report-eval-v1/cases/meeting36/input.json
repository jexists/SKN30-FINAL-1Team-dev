        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0014",
          "start": 538,
          "end": 575,
          "text": "진해온: 연간으로 제안받은 CRM은 거절 상태를 유지하고 있습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0015",
          "start": 576,
          "end": 625,
          "text": "지난주에 거절한 제안을 이번 주에 새로 성사되지 않은 건으로 다시 세는 의미는 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0016",
          "start": 626,
          "end": 676,
          "text": "저희가 원했던 조건은 월 단위 해지였고, 기능이 마음에 들지 않아서 종료한 것은 아니에요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0017",
          "start": 677,
          "end": 774,
          "text": "영업 담당자: 그러면 CRM에 대한 현재 결론은 기능 평가가 나빠서 끝난 것이 아니라, 연간 제안과 월 단위 해지 조건이 맞지 않아 이번 분기 검토를 종료한 쪽에 가깝겠네요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0018",
          "start": 775,
          "end": 819,
          "text": "시연계정은 꺼져 있고, 연간 제안의 거절 상태도 그대로인 상황으로 이해했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0019",
          "start": 820,
          "end": 839,
          "text": "진해온: 네, 그 이해가 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0020",
          "start": 840,
          "end": 921,
          "text": "제작 영업 CRM에서 의뢰나 제안, 계약과 제작 착수 같은 단계를 나눠 보고 고객 피드백과 범위변경을 따라가는 방식 자체를 부정한 것은 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0021",
          "start": 922,
          "end": 947,
          "text": "다만 지금은 연간 조건으로 진행하지 않습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0022",
          "start": 948,
          "end": 962,
          "text": "영업 담당자: 알겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0023",
          "start": 963,
          "end": 1016,
          "text": "CRM과 관련해서는 오늘 다시 기능 시연을 이어 가거나 연간 조건을 재협의하는 단계는 아니군요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0024",
          "start": 1017,
          "end": 1039,
          "text": "그럼 견적 버전 자동화로 넘어가겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0025",
          "start": 1040,
          "end": 1082,
          "text": "진해온: 견적도구는 6월 22일에 답변을 드린 내용부터 짚어 주시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0026",
          "start": 1083,
          "end": 1120,
          "text": "프로젝트 코드로 독립해서 사용할 수 있는지는 가능하다고 답변했어요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0027",
          "start": 1121,
          "end": 1181,
          "text": "영업 담당자: 프로젝트 코드 기준으로 다른 사용 흐름과 독립해 사용할 수 있다는 답변을 받았다는 말씀이군요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0028",
          "start": 1182,
          "end": 1240,
          "text": "그러면 촬영일수, 수정회차, 산출물 범위를 넣어 버전을 관리하는 기본 방식은 검토 대상에 남아 있습니까?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0029",
          "start": 1241,
          "end": 1271,
          "text": "진해온: 기본적인 독립 사용 가능 여부는 확인했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0030",
          "start": 1272,
          "end": 1308,
          "text": "다만 저희가 실제로 보려는 것은 PDF가 어떻게 설정되는지입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0031",
          "start": 1309,
          "end": 1371,
          "text": "기본 PDF 서식만 쓰는지, 추가 항목을 넣을 수 있는지, 그 범위에서 어떤 검토가 필요한지를 더 봐야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0032",
          "start": 1372,
          "end": 1409,
          "text": "영업 담당자: PDF 설정 범위를 추가로 살펴봐야 한다는 뜻이군요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0033",
          "start": 1410,
          "end": 1502,
          "text": "단순히 프로젝트 코드로 따로 쓸 수 있다는 답변만으로는 내부 판단을 끝낼 수 없고, 견적 결과물이 어떤 서식과 항목으로 나오는지 확인해야 하는 상황으로 이해했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0034",
          "start": 1503,
          "end": 1510,
          "text": "진해온: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0035",
          "start": 1511,
          "end": 1561,
          "text": "특히 다음 달에 대형 제작 일정이 있어서 그 검토를 맡을 인력을 배정하지 못하고 있습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0036",
          "start": 1562,
          "end": 1607,
          "text": "그래서 견적 버전 자동화 도구는 지금 바로 진행하지 않고 잠시 보류하려고 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0037",
          "start": 1608,
          "end": 1689,
          "text": "영업 담당자: 검토 인력 부족과 다음 달 대형 제작 일정 때문에 보류하는 것이지, 프로젝트 코드로 독립 사용이 불가능하다고 판단한 것은 아니군요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0038",
          "start": 1690,
          "end": 1701,
          "text": "진해온: 그렇습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0039",
          "start": 1702,
          "end": 1747,
          "text": "독립 사용 가능하다는 답변은 받았고, PDF 설정을 더 확인해야 하는 상태입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0040",
          "start": 1748,
          "end": 1772,
          "text": "다만 현재는 내부에서 볼 사람이 부족합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0041",
          "start": 1773,
          "end": 1796,
          "text": "견적도구 계약서에 서명한 사실도 없습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0042",
          "start": 1797,
          "end": 1848,
          "text": "영업 담당자: 계약서 서명은 아직 없고, 도구 검토도 보류 중이라는 점을 함께 확인했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0043",
          "start": 1849,
          "end": 1919,
          "text": "그러면 지금 필요한 것은 비용 승인을 바로 받는 절차가 아니라, 어떤 설정에 추가 작업이 필요한지 판단할 수 있는 자료겠네요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0044",
          "start": 1920,
          "end": 1929,
          "text": "진해온: 맞아요."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0045",
          "start": 1930,
          "end": 1963,
          "text": "지금 당장 비용을 승인해 달라는 요청을 드리는 게 아닙니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0046",
          "start": 1964,
          "end": 2033,
          "text": "내부 인력이 확보됐을 때 기본 PDF 서식과 추가 설정 항목을 보고, 저희가 무엇을 더 검토해야 하는지 이해하려는 것입니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0047",
          "start": 2034,
          "end": 2098,
          "text": "영업 담당자: 그 자료는 기본 PDF 서식과 추가 설정 항목을 한 장으로 묶어서 6월 29일까지 전달할 예정입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0048",
          "start": 2099,
          "end": 2156,
          "text": "견적도구의 독립 사용 가능 여부와 PDF 설정 검토가 필요한 지점을 한눈에 볼 수 있게 준비하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0049",
          "start": 2157,
          "end": 2178,
          "text": "진해온: 6월 29일까지 보내 주세요."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0050",
          "start": 2179,
          "end": 2219,
          "text": "자료를 받은 뒤 내부 인력이 확보되면 그 내용을 가지고 다시 보겠습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0051",
          "start": 2220,
          "end": 2267,
          "text": "다만 지금 그 검토가 언제 끝날지, 또는 언제 다시 시작할지는 말씀드리기 어렵습니다."
        },
        "applicability": {
          "scope": "meeting_context",
          "deal_ids": []
        }
      },
      {
        "segment": {
          "segment_id": "S0052",
          "start": 2268,
          "end": 2332,
          "text": "영업 담당자: 네, 현재 확인 가능한 일정은 기본 서식과 추가 설정 항목표를 6월 29일까지 전달하는 것까지입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0053",
          "start": 2333,
          "end": 2380,
          "text": "그 이후 검토 시점은 내부 인력과 제작 일정이 정리된 뒤 판단하는 것으로 두겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0054",
          "start": 2381,
          "end": 2396,
          "text": "진해온: 그 정도면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0055",
          "start": 2397,
          "end": 2448,
          "text": "PDF가 기본 설정으로 충분한지, 추가 설정이 필요한 부분이 무엇인지 먼저 확인해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0056",
          "start": 2449,
          "end": 2486,
          "text": "그 전에는 견적 버전 자동화 도구의 진행 여부를 정하기 어렵습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0057",
          "start": 2487,
          "end": 2518,
          "text": "영업 담당자: 이제 프로듀서 이용 교육을 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0058",
          "start": 2519,
          "end": 2588,
          "text": "현재 교육은 이미 시작했거나 일부 진행된 상태가 아니라, 도구 범위와 사용일정을 먼저 정해야 하는 보류 상태로 보면 될까요?"
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0059",
          "start": 2589,
          "end": 2596,
          "text": "진해온: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0060",
          "start": 2597,
          "end": 2617,
          "text": "이번 달 교육은 진행하지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0061",
          "start": 2618,
          "end": 2676,
          "text": "교육부터 먼저 잡기보다는 어떤 도구 범위를 사용할지, 실제 사용일정을 어떻게 정할지부터 확인해야 합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0062",
          "start": 2677,
          "end": 2758,
          "text": "영업 담당자: 프로듀서 이용 교육에서 다루는 변경요청, 견적승인, 인계 기록은 도구 범위와 일정이 정해진 다음에야 실습 방식도 정할 수 있겠네요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0063",
          "start": 2759,
          "end": 2769,
          "text": "진해온: 맞습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0064",
          "start": 2770,
          "end": 2795,
          "text": "그래서 교육은 미실시 상태이고 보류 중입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0065",
          "start": 2796,
          "end": 2839,
          "text": "세 프로젝트를 가지고 연습하는 실습안은 나중에 활용할 수 있도록 남겨 주세요."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0066",
          "start": 2840,
          "end": 2864,
          "text": "지금 당장 교육을 진행하자는 뜻은 아닙니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0067",
          "start": 2865,
          "end": 2937,
          "text": "영업 담당자: 세 프로젝트 실습안은 이후에 사용할 수 있는 자료로 남겨 두고, 현재 교육 일정은 정하지 않는 것으로 이해했습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0068",
          "start": 2938,
          "end": 3007,
          "text": "제작 일정이 정리된 뒤 검토 가능한 시점을 다시 알려 주실 수는 있지만, 오늘 특정 날짜를 정하는 것은 어렵다는 말씀이시죠."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0069",
          "start": 3008,
          "end": 3015,
          "text": "진해온: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0070",
          "start": 3016,
          "end": 3054,
          "text": "제작 일정이 정리되면 제가 교육 검토가 가능한 시점을 회신하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0071",
          "start": 3055,
          "end": 3082,
          "text": "하지만 현재는 재검토 날짜를 확답할 수 없습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0072",
          "start": 3083,
          "end": 3118,
          "text": "교육을 진행한 것으로 보거나 날짜를 미리 잡아 두면 안 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0073",
          "start": 3119,
          "end": 3133,
          "text": "영업 담당자: 알겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0074",
          "start": 3134,
          "end": 3195,
          "text": "교육은 이번 달에 실시하지 않았고, 도구 범위와 사용일정이 먼저이며, 재검토 시점은 아직 정해지지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0075",
          "start": 3196,
          "end": 3228,
          "text": "실습안만 나중에 쓸 수 있도록 유지하는 상태로 보겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0076",
          "start": 3229,
          "end": 3248,
          "text": "진해온: 그렇게 이해하시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0077",
          "start": 3249,
          "end": 3282,
          "text": "견적도구도 보류이고 교육도 보류지만, 이유는 서로 다릅니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0078",
          "start": 3283,
          "end": 3342,
          "text": "견적도구는 PDF 설정과 검토 인력 문제이고, 교육은 도구 범위와 사용일정을 먼저 정해야 하기 때문입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0079",
          "start": 3343,
          "end": 3452,
          "text": "영업 담당자: 제품별로 구분하면 CRM은 6월 22일 시연계정 비활성화와 연간 제안 거절 상태가 유지되고, 견적도구는 독립 사용 가능 답변은 받았지만 PDF 설정 검토와 인력 부족으로 보류입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003",
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0080",
          "start": 3453,
          "end": 3483,
          "text": "교육은 아직 실시하지 않았고 재검토 날짜도 미정입니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003",
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0081",
          "start": 3484,
          "end": 3491,
          "text": "진해온: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003",
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0082",
          "start": 3492,
          "end": 3504,
          "text": "그 구분이 중요합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003",
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0083",
          "start": 3505,
          "end": 3576,
          "text": "CRM은 기능 자체의 부정적 평가로 종료된 것이 아니고, 견적도구는 계약서에 서명한 적이 없으며, 교육은 진행된 적이 없습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "56e34430-ebf2-5b29-86bc-cca406076003",
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0084",
          "start": 3577,
          "end": 3599,
          "text": "영업 담당자: 마지막으로 확인하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0085",
          "start": 3600,
          "end": 3679,
          "text": "6월 29일까지는 기본 PDF 서식과 추가 설정 항목을 한 장으로 전달하고, 그 자료를 바탕으로 한 내부 검토는 인력이 확보된 뒤 진행합니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0086",
          "start": 3680,
          "end": 3728,
          "text": "비용 승인을 지금 요청하는 단계는 아니며, 교육 재검토 날짜도 별도로 정하지 않습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0087",
          "start": 3729,
          "end": 3736,
          "text": "진해온: 네."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0088",
          "start": 3737,
          "end": 3761,
          "text": "6월 29일까지 자료를 보내 주시면 됩니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0089",
          "start": 3762,
          "end": 3828,
          "text": "내부 인력이 확보되면 그때 PDF 설정을 다시 보고, 제작 일정이 정리되면 교육 검토 가능 시점을 제가 회신하겠습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      },
      {
        "segment": {
          "segment_id": "S0090",
          "start": 3829,
          "end": 3883,
          "text": "지금 확정된 것은 자료를 받는 일뿐이고, 견적도구 진행이나 교육 날짜는 아직 정해지지 않았습니다."
        },
        "applicability": {
          "scope": "deal",
          "deal_ids": [
            "fce17706-12aa-5c1c-bd6b-144a25b67526",
            "a887668f-84c1-58ec-a6fb-33a718204ea9"
          ]
        }
      }
    ]
